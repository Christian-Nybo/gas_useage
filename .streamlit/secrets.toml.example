# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# Also paste the same values into the Streamlit Community Cloud app's Secrets panel.

[supabase]
url = "https://<project>.supabase.co"
key = "<anon-key>"

[supabase_auth]
email = "<service-account-email>"
password = "<service-account-password>"

[auth]
password = "your-strong-password-here"
