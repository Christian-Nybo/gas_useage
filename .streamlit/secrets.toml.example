# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# Also paste the same values into the Streamlit Community Cloud app's Secrets panel.

[supabase]
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_KEY = "<anon-public-key>"

[supabase_auth]
USER_EMAIL = "<service-account-email>"
USER_PASSWORD = "<service-account-password>"

[auth]
password = "<your-strong-dashboard-password>"
